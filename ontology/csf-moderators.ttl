@prefix : <http://purl.org/csf/moderators#> .
@prefix csf: <http://purl.org/csf/> .
@prefix core: <http://purl.org/csf/core#> .
@prefix frm: <http://purl.org/csf/frames#> .
@prefix mod: <http://purl.org/csf/moderators#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .

csf:moderators
    a owl:Ontology ;
    rdfs:comment "v3.2 / Req 8, Req 17): The moderator module models amplifiers and buffers but lacks an explicit Intervention class. Interventions (therapy, policy, social support programs) are distinct from naturally-occurring buffers. A dedicated csf-interventions.ttl module is proposed (REIFIED hypothesis H7) with csf:Intervention class, sit:mitigates, sit:targetsMechanism, and sit:evidenceLevel properties."@en ;
    owl:imports csf:outcomes ;
    dcterms:title "CSF Moderators Module (Refactored)"@en ;
    owl:versionInfo "3.2.2" .


# ==========================================================
# MODERATOR-FRAME INTERACTION (v3.2 extension — Req 4)
# ==========================================================

mod:moderatesOutcome a owl:ObjectProperty ;
    rdfs:domain csf:Moderator ;
    rdfs:range csf:ClinicalOutcome ;
    rdfs:label "moderates outcome"@en ;
    rdfs:comment "Links a moderator to a clinical outcome it influences (amplifying or buffering severity)."@en .

mod:interactsWith a owl:ObjectProperty ;
    rdfs:domain csf:Moderator ;
    rdfs:range csf:CorticoidogenicFrame ;
    rdfs:label "interacts with"@en ;
    rdfs:comment "Links a moderator to a corticoidogenic frame it modulates."@en .

mod:effectSize a owl:DatatypeProperty ;
    rdfs:domain csf:Moderator ;
    rdfs:range rdfs:Literal ;
    rdfs:label "effect size"@en ;
    rdfs:comment "Reported effect size for this moderator (e.g., 'OR 2.0-4.0 for PTSD')."@en .

mod:amplificationFactor a owl:DatatypeProperty ;
    rdfs:domain mod:Amplifier ;
    rdfs:range xsd:float ;
    rdfs:label "amplification factor"@en ;
    rdfs:comment "Multiplicative factor by which this amplifier increases cascade severity."@en .

mod:bufferingFactor a owl:DatatypeProperty ;
    rdfs:domain mod:Buffer ;
    rdfs:range xsd:float ;
    rdfs:label "buffering factor"@en ;
    rdfs:comment "Multiplicative factor by which this buffer reduces cascade severity (0.0 = complete protection, 1.0 = no effect)."@en .

# NOTE (v3.2 / Req 8, Req 17): The moderator module models amplifiers and buffers
# but lacks an explicit Intervention class. Interventions (therapy, policy, social support
# programs) are distinct from naturally-occurring buffers. A dedicated csf-interventions.ttl
# module is proposed (REIFIED hypothesis H7) with csf:Intervention class, sit:mitigates,
# sit:targetsMechanism, and sit:evidenceLevel properties.
mod:Amplifier a owl:Class ; rdfs:subClassOf csf:Moderator .
mod:Buffer a owl:Class ; rdfs:subClassOf csf:Moderator .
mod:GeneticModerator a owl:Class ; rdfs:subClassOf csf:Moderator .
mod:DevelopmentalModerator a owl:Class ; rdfs:subClassOf csf:Moderator .
mod:BehavioralModerator a owl:Class ; rdfs:subClassOf csf:Moderator .
mod:SocialModerator a owl:Class ; rdfs:subClassOf csf:Moderator .
mod:CognitiveModerator a owl:Class ; rdfs:subClassOf csf:Moderator .
mod:ContextualModerator a owl:Class ; rdfs:subClassOf csf:Moderator .

# ==========================================
# AMPLIFIERS (Converted to Individuals)
# ==========================================
mod:FKBP5RiskVariant a mod:Amplifier, mod:GeneticModerator, owl:NamedIndividual ;
    rdfs:label "FKBP5 Risk Variant"@en ;
    csf:pubmedID "24051924" ;
    mod:effectSize "OR 2.0-4.0 for PTSD"@en ;
    mod:interactsWith frm:EarlyLifeProgrammingFrame, frm:UncontrollableThreatFrame .

mod:CRHR1RiskVariant a mod:Amplifier, mod:GeneticModerator, owl:NamedIndividual ;
    rdfs:label "CRHR1 Risk Variant"@en ;
    csf:pubmedID "17615391" .

mod:NR3C1RiskVariant a mod:Amplifier, mod:GeneticModerator, owl:NamedIndividual ;
    rdfs:label "NR3C1 Risk Variant"@en ;
    csf:pubmedID "17615391" .

mod:SLC6A4ShortAllele a mod:Amplifier, mod:GeneticModerator, owl:NamedIndividual ;
    rdfs:label "5-HTTLPR Short Allele"@en ;
    mod:interactsWith frm:EarlyLifeProgrammingFrame .

mod:EarlyAdversityHistory a mod:Amplifier, mod:DevelopmentalModerator, owl:NamedIndividual ;
    rdfs:label "Early Adversity History"@en ;
